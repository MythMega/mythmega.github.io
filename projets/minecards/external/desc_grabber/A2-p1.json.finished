    {
      "Index": "SERIE-A2 / N025",
      "Name_FR": "Bloc de verrues du Nether",
      "Name_EN": "Nether Wart Block",
      "Desc_FR": "Le bloc de verrues du Nether (nom anglais : nether wart block) est un bloc décoratif qui apparaît dans les forêts carmin et peut être fabriqué à partir de verrues du Nether.",
      "Desc_EN": "Nether wart blocks are decorative blocks found in crimson forests and crafted using Nether wart.",
      "Rarity": 1,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "https://raw.githubusercontent.com/MythMega/mythmega.github.io.assets/refs/heads/master/assets/category/minecraft/blocks/Nether_Wart_Block.png",
      "Layout": "classic",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ N025_classic.png"
    },
    {
      "Index": "SERIE-A2 / A001",
      "Name_FR": "Sable des âmes",
      "Name_EN": "Soul Sand",
      "Desc_FR": "Le sable des âmes (nom anglais : soul sand) est un bloc uniquement trouvable dans le Nether.",
      "Desc_EN": "Soul sand is a block found primarily in the Nether that slows down entities walking on it unless they are wearing Soul Speed boots. It can also be used to grow Nether wart, create soul fire, make upward bubble columns, and spawn withers. It appears to have souls in the block, where can be freed by running on them with Soul Speed boots (although this is a cosmetic particle effect).",
      "Rarity": 1,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "https://raw.githubusercontent.com/MythMega/mythmega.github.io.assets/refs/heads/master/assets/category/minecraft/blocks/Soul_Sand.png",
      "Layout": "classic",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ A001_classic.png"
    },
    {
      "Index": "SERIE-A2 / A002",
      "Name_FR": "Terre des âmes",
      "Name_EN": "Soul Soil",
      "Desc_FR": "La terre des âmes (nom anglais : soul soil) est un bloc uniquement trouvable dans la vallée des âmes, dans le Nether.",
      "Desc_EN": "Soul soil is a block found abundantly in soul sand valleys. It does not slow down entities, but still activates Soul Speed. It can also be used to create soul fire, and generate basalt when paired with blue ice and lava.",
      "Rarity": 1,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "https://raw.githubusercontent.com/MythMega/mythmega.github.io.assets/refs/heads/master/assets/category/minecraft/blocks/Soul_Soil.png",
      "Layout": "classic",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ A002_classic.png"
    },
    {
      "Index": "SERIE-A2 / A003",
      "Name_FR": "Feu des âmes",
      "Name_EN": "Soul Fire",
      "Desc_FR": "Le feu des âmes (nom anglais : soul fire) est une variante turquoise du feu qui ne se trouve que sur les blocs de sable des âmes et terre des âmes. Le feu des âmes fait plus de dégâts que le feu normal et ne se propage pas.",
      "Desc_EN": "Soul fire is a dimmer turquoise variation of fire that is created when soul sand or soul soil is ignited. Soul fire deals more damage than normal fire and does not spread.",
      "Rarity": 1,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "https://raw.githubusercontent.com/MythMega/mythmega.github.io.assets/refs/heads/master/assets/category/minecraft/blocks/Soul_Fire.png",
      "Layout": "classic",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ A003_classic.png"
    },
    {
      "Index": "SERIE-A2 / A004",
      "Name_FR": "Feu de camp des âmes",
      "Name_EN": "Soul Campfire",
      "Desc_FR": "Le feu de camp des âmes (nom anglais : soul campfire) est une variante moins lumineuse du feu de camp. Les feux de camp des âmes infligent plus de dégâts que les feux de camp classiques et ont des flammes de couleur turquoise. Tout comme un feu de camp normal, il peut être utilisé pour faire cuire de la nourriture, apaiser les abeilles ou servir de source de lumière, de signal de fumée ou de piège.",
      "Desc_EN": "Soul campfires are dimmer variants of campfires. Soul campfires deal more damage than normal campfires and have turquoise flames. Just like normal campfires, they can be used to cook food, pacify bees, or act as a spread-proof light source, smoke signal, or damaging trap block. Crafting soul campfires with soul sand and then breaking them to convert the soul sand into soul soil (similarly to converting 1 coal into 2 charcoal) is the only renewable source of soul soil.",
      "Rarity": 1,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "https://raw.githubusercontent.com/MythMega/mythmega.github.io.assets/refs/heads/master/assets/category/minecraft/blocks/Soul_Campfire.png",
      "Layout": "classic",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ A004_classic.png"
    },
    {
      "Index": "SERIE-A2 / A005",
      "Name_FR": "Torche des âmes",
      "Name_EN": "Soul Torch",
      "Desc_FR": "Une torche des âmes (nom anglais : soul torch) est un bloc non solide qui émet de la lumière. Il s'agit d'une variante de la torche fabriquée avec de la terre des âmes ou du sable des âmes.",
      "Desc_EN": "Soul torches are non-solid blocks that emit light. They are a variant of the torch crafted with the addition of soul soil or soul sand.",
      "Rarity": 1,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "https://raw.githubusercontent.com/MythMega/mythmega.github.io.assets/refs/heads/master/assets/category/minecraft/blocks/Soul_Torch.png",
      "Layout": "classic",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ A005_classic.png"
    },
    {
      "Index": "SERIE-A2 / A006",
      "Name_FR": "Lanterne des âmes",
      "Name_EN": "Soul Lantern",
      "Desc_FR": "La lanterne des âmes (nom anglais : soul lantern) est un bloc qui emet de la lumière. Il s'agit de la variante turquoise de la lanterne fabriquée à partir d'une torche des âmes.",
      "Desc_EN": "The soul lantern is a block that emits light. It is a variant of the lantern, and is crafted from a soul torch.",
      "Rarity": 2,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "https://raw.githubusercontent.com/MythMega/mythmega.github.io.assets/refs/heads/master/assets/category/minecraft/blocks/Soul_Lantern.png",
      "Layout": "classic",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ A006_classic.png"
    },
    {
      "Index": "SERIE-A2 / D001",
      "Name_FR": "Basalte",
      "Name_EN": "Basalt",
      "Desc_FR": "Le basalte (nom anglais : basalt) est un bloc qui se trouve dans le Nether.",
      "Desc_EN": "Basalt is a block found in the basalt deltas in the Nether along with soul sand valleys and bastion remnants.",
      "Rarity": 1,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "https://raw.githubusercontent.com/MythMega/mythmega.github.io.assets/refs/heads/master/assets/category/minecraft/blocks/Basalt.png",
      "Layout": "classic",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ D001_classic.png"
    },
    {
      "Index": "SERIE-A2 / D002",
      "Name_FR": "Basalte poli",
      "Name_EN": "Polished Basalt",
      "Desc_FR": "Le basalte poli (nom anglais : polished basalt) est une variante polie du basalte.",
      "Desc_EN": "Polished basalt is the polished version of basalt and can be found as part of ancient cities and bastion remnants.",
      "Rarity": 1,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "https://raw.githubusercontent.com/MythMega/mythmega.github.io.assets/refs/heads/master/assets/category/minecraft/blocks/Polished_Basalt.png",
      "Layout": "classic",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ D002_classic.png"
    },
    {
      "Index": "SERIE-A2 / D003",
      "Name_FR": "Basalte lisse",
      "Name_EN": "Smooth Basalt",
      "Desc_FR": "Le basalte lisse (nom anglais : smooth basalt) est un bloc décoratif dérivé du basalte qui se trouve à l'état naturel dans les géodes d'améthyste et les anciennes cités.",
      "Desc_EN": "Smooth basalt is an ornamental rock smelted from basalt or found as part of amethyst geodes and ancient cities.",
      "Rarity": 1,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "https://raw.githubusercontent.com/MythMega/mythmega.github.io.assets/refs/heads/master/assets/category/minecraft/blocks/Smooth_Basalt.png",
      "Layout": "classic",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ D003_classic.png"
    },
    {
      "Index": "SERIE-A2 / D004",
      "Name_FR": "Bloc de magma",
      "Name_EN": "Magma Block",
      "Desc_FR": "Les blocs de magma (nom anglais : magma blocks) sont des blocs générés naturellement dans le Nether et la Surface et qui occasionnent des dégâts de feu aux créatures qui marchent dessus. Ils émettent une faible lumière et ont une texture animée.",
      "Desc_EN": "A magma block is a light-emitting block found underwater in the Overworld, and commonly in the Nether. It deals burning damage while stood on, which can be prevented by sneaking. Underwater magma blocks produce bubble columns that pull entities downward and provide air.",
      "Rarity": 1,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "https://raw.githubusercontent.com/MythMega/mythmega.github.io.assets/refs/heads/master/assets/category/minecraft/blocks/Magma_Block.png",
      "Layout": "classic",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ D004_classic.png"
    },
    {
      "Index": "SERIE-A2 / U001",
      "Name_FR": "Magnétite",
      "Name_EN": "Lodestone",
      "Desc_FR": "La magnétite (nom anglais : lodestone) est un bloc qui peut être utilisé pour modifier le lieu vers lequel pointe une boussole.",
      "Desc_EN": "A lodestone is a block that can be used to alter compasses to point toward it.",
      "Rarity": 2,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "https://raw.githubusercontent.com/MythMega/mythmega.github.io.assets/refs/heads/master/assets/category/minecraft/blocks/Lodestone.png",
      "Layout": "classic",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ U001_classic.png"
    },
    {
      "Index": "SERIE-A2 / U002",
      "Name_FR": "Ancre de réapparition",
      "Name_EN": "Respawn Anchor",
      "Desc_FR": "L'ancre de réapparition (nom anglais : respawn anchor) est un bloc permettant aux joueurs de définir leur point d'apparition dans le Nether. Elle peut être chargée avec de la pierre lumineuse et perd un niveau de charge chaque fois qu'un joueur l'utilise pour réapparaître. Son utilisation dans le monde normal ou l'End provoque une explosion et la disparition du bloc.",
      "Desc_EN": "The respawn anchor is a block that allows the player to set their spawn point in the Nether, provided it's fueled with glowstone blocks.",
      "Rarity": 3,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "https://raw.githubusercontent.com/MythMega/mythmega.github.io.assets/refs/heads/master/assets/category/minecraft/blocks/Respawn_Anchor.png",
      "Layout": "classic",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ U002_classic.png"
    },
    {
      "Index": "SERIE-A2 / U003",
      "Name_FR": "Chaîne",
      "Name_EN": "Iron Chain",
      "Desc_FR": "Une chaîne en fer (nom anglais : iron chain) est un bloc décoratif.",
      "Desc_EN": "Iron chains are metal decoration blocks and the iron variant of the chain.",
      "Rarity": 1,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "https://raw.githubusercontent.com/MythMega/mythmega.github.io.assets/refs/heads/master/assets/category/minecraft/blocks/Iron_Chain.png",
      "Layout": "classic",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ U003_classic.png"
    },
    {
      "Index": "SERIE-A2 / U004",
      "Name_FR": "Roche noire dorée",
      "Name_EN": "Gilded Blackstone",
      "Desc_FR": "La roche noire dorée (nom anglais : gilded blackstone) est variante de la roche noire qui donne elle-même ou des pépites d'or lorsqu'elle est minée.",
      "Desc_EN": "Gilded blackstone is a variant of blackstone found exclusively in bastion remnants, that can drop itself or gold nuggets when mined.",
      "Rarity": 2,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "https://raw.githubusercontent.com/MythMega/mythmega.github.io.assets/refs/heads/master/assets/category/minecraft/blocks/Gilded_Blackstone.png",
      "Layout": "classic",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ U004_classic.png"
    },
    {
      "Index": "SERIE-A2 / U005",
      "Name_FR": "Bloc de portail du Nether",
      "Name_EN": "Nether Portal (block)",
      "Desc_FR": "",
      "Desc_EN": "The Nether portal block is the translucent part of the Nether portal that teleports the player to and from the Nether.",
      "Rarity": 2,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "https://raw.githubusercontent.com/MythMega/mythmega.github.io.assets/refs/heads/master/assets/category/minecraft/blocks/Nether_Portal_(block).png",
      "Layout": "classic",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ U005_classic.png"
    },
    {
      "Index": "SERIE-A2 / U006",
      "Name_FR": "Débris antiques",
      "Name_EN": "Ancient Debris",
      "Desc_FR": "Les débris antiques (nom anglais : ancient debris) sont des minerais très rares qui se trouvent uniquement dans le Nether. Ils sont la source principale de fragments de netherite. Ils flottent dans la lave et ne brûlent pas au contact de la lave ou du feu. Ils ont également une très forte résistance aux explosions, ce qui veut dire qu'ils ne peuvent pas exploser dans des conditions normales.",
      "Desc_EN": "Ancient debris is a rare ore found in the Nether. It is the main source of netherite scraps, which can then be used to craft netherite ingots. Its high blast resistance makes it immune to normal explosions. In item form, it floats on lava and is completely immune to any form of fire.",
      "Rarity": 3,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "https://raw.githubusercontent.com/MythMega/mythmega.github.io.assets/refs/heads/master/assets/category/minecraft/blocks/Ancient_Debris.png",
      "Layout": "classic",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ U006_classic.png"
    },
    {
      "Index": "SERIE-A2 / U007",
      "Name_FR": "Fragments de Netherite",
      "Name_EN": "Netherite Scrap",
      "Desc_FR": "Un fragment de netherite (nom anglais : netherite scrap) est un objet qui s'obtient en faisant cuire un bloc de débris antiques dans un fourneau ou haut fourneau.",
      "Desc_EN": "Netherite scrap is a material smelted from ancient debris, which is found in the Nether. It is used solely for crafting netherite ingots. Like all netherite-related items, it is resistant to fire and lava in item form.",
      "Rarity": 3,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "https://raw.githubusercontent.com/MythMega/mythmega.github.io.assets/refs/heads/master/assets/category/minecraft/items/Netherite_Scrap.png",
      "Layout": "classic",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ U007_classic.png"
    },
    {
      "Index": "SERIE-A2 / U008",
      "Name_FR": "Lingot de Netherite",
      "Name_EN": "Netherite Ingot",
      "Desc_FR": "Le lingot de netherite (nom anglais : netherite ingot) est un objet qui permet de fabriquer des armures et outils plus puissants que le diamant. Contrairement aux autres objets et matériaux, les objets en netherite ne brûlent pas dans la lave et remontent à la surface.",
      "Desc_EN": "A netherite ingot is an item obtained from crafting four netherite scraps and four gold ingots together, as well as being loot from bastion remnant loot chests. Unlike other items, it is immune to being destroyed by fire and lava. They are primarily used to upgrade diamond gear.",
      "Rarity": 3,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "https://raw.githubusercontent.com/MythMega/mythmega.github.io.assets/refs/heads/master/assets/category/minecraft/items/Netherite_Ingot.png",
      "Layout": "classic",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ U008_classic.png"
    },
    {
      "Index": "SERIE-A2 / U009",
      "Name_FR": "Bloc de netherite",
      "Name_EN": "Block of Netherite",
      "Desc_FR": "Les blocs de netherite (nom anglais : block of netherite) est un bloc de stockage fabriqué avec des lingots de netherite.",
      "Desc_EN": "A block of netherite, internally known as a netherite block, is a precious metal block made from nine netherite ingots. In item form, it is immune to fire and lava, but can still be destroyed by a cactus.",
      "Rarity": 4,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "https://raw.githubusercontent.com/MythMega/mythmega.github.io.assets/refs/heads/master/assets/category/minecraft/blocks/Block_of_Netherite.png",
      "Layout": "classic",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ U009_classic.png"
    },
    {
      "Index": "SERIE-A2 / U010",
      "Name_FR": "Alambic",
      "Name_EN": "Brewing Stand",
      "Desc_FR": "L'alambic (nom anglais : brewing stand) est un bloc utilisé pour fabriquer des potions, des potions jetables et des potions persistantes.",
      "Desc_EN": "A brewing stand is a block used for brewing potions using water bottles and suitable ingredients. It also serves as a cleric's job site block.",
      "Rarity": 2,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "https://raw.githubusercontent.com/MythMega/mythmega.github.io.assets/refs/heads/master/assets/category/minecraft/blocks/Brewing_Stand.png",
      "Layout": "classic",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ U010_classic.png"
    },
    {
      "Index": "SERIE-A2 / U011",
      "Name_FR": "Potion",
      "Name_EN": "Potion",
      "Desc_FR": "Les potions sont des objets qui, une fois consommés, procurent des effets temporaires. Toutes les potions sont contenues dans des fioles et sont principalement obtenables à l'aide de l'alchimie.",
      "Desc_EN": "Potions are bottled consumable liquids that give effects for a certain amount of time when drunk. They are primarily obtained from brewing. Every potion is brewed starting from a water bottle, which is considered a type of potion that has no effects.",
      "Rarity": 5,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "https://raw.githubusercontent.com/MythMega/mythmega.github.io.assets/refs/heads/master/assets/category/minecraft/items/Water_Bottle.png",
      "Layout": "classic",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ U011_classic.png"
    },
    {
      "Index": "SERIE-A2 / U012",
      "Name_FR": "Champignon biscornu sur un bâton",
      "Name_EN": "Warped Fungus on a Stick",
      "Desc_FR": "Le champignon biscornu sur un bâton (nom anglais : warped fungus on a stick) est un outil qui peut être utilisé pour contrôler des arpenteurs sellés.",
      "Desc_EN": "A warped fungus on a stick is a tool that can be used to control saddled striders.",
      "Rarity": 1,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "https://raw.githubusercontent.com/MythMega/mythmega.github.io.assets/refs/heads/master/assets/category/minecraft/items/Warped_Fungus_on_a_Stick.png",
      "Layout": "classic",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ U012_classic.png"
    },
    {
      "Index": "SERIE-A2 / L001",
      "Name_FR": "Larme de Ghast",
      "Name_EN": "Ghast Tear",
      "Desc_FR": "Les larmes de Ghast (nom anglais : ghast tears) sont des objets obtenus à la mort des Ghasts.",
      "Desc_EN": "Ghast tears are items dropped by ghasts that are used to make dried ghasts, End crystals, and potions of Regeneration.",
      "Rarity": 1,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "https://raw.githubusercontent.com/MythMega/mythmega.github.io.assets/refs/heads/master/assets/category/minecraft/items/Ghast_Tear.png",
      "Layout": "classic",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ L001_classic.png"
    },
    {
      "Index": "SERIE-A2 / L002",
      "Name_FR": "Bâton de Blaze",
      "Name_EN": "Blaze Rod",
      "Desc_FR": "Les bâtons de Blaze (nom anglais : blaze rods) sont des objets lâchés par les Blazes.",
      "Desc_EN": "A blaze rod is an item obtained by killing blazes. It is required to craft brewing stands and blaze powder, which is required to fuel brewing stands and craft eyes of ender.",
      "Rarity": 1,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "https://raw.githubusercontent.com/MythMega/mythmega.github.io.assets/refs/heads/master/assets/category/minecraft/items/Fire_Wand.png",
      "Layout": "classic",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ L002_classic.png"
    },
    {
      "Index": "SERIE-A2 / L003",
      "Name_FR": "Crème de magma",
      "Name_EN": "Magma Cream",
      "Desc_FR": "La crème de magma (nom anglais : magma cream) est un objet qui s'obtient via l'artisanat ou en tuant des cubes de magma. Elle entre dans la composition de la potion de résistance au feu et dans la fabrication du bloc de magma.",
      "Desc_EN": "Magma cream is an item dropped by magma cubes or crafted with blaze powder and slimeballs, used to brew potions of Fire Resistance and craft magma blocks.",
      "Rarity": 1,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "https://raw.githubusercontent.com/MythMega/mythmega.github.io.assets/refs/heads/master/assets/category/minecraft/items/Magma_Cream.png",
      "Layout": "classic",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ L003_classic.png"
    },
    {
      "Index": "SERIE-A2 / L004",
      "Name_FR": "Crâne de wither squelette",
      "Name_EN": "Wither Skeleton Skull",
      "Desc_FR": "Une tête ou un crâne (noms anglais : head ou skull) est un bloc décoratif qui représente la tête d'une créature. Il en existe sept variantes : le squelette, le Wither squelette, le joueur (qui par défaut, est une tête de Steve, mais peut être modifiée par des commandes), le zombie, le Creeper, le Piglin, et l'Ender Dragon.",
      "Desc_EN": "A wither skeleton skull is the head of a wither skeleton in the form of a block, which is a rare drop from killed wither skeletons. Three of them can be used to summon a wither, a destructive boss mob that is the only source of Nether stars.",
      "Rarity": 3,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "https://raw.githubusercontent.com/MythMega/mythmega.github.io.assets/refs/heads/master/assets/category/minecraft/blocks/Wither_Skeleton_Skull.png",
      "Layout": "classic",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ L004_classic.png"
    },
    {
      "Index": "SERIE-A2 / L005",
      "Name_FR": "Seau de lave",
      "Name_EN": "Lava Bucket",
      "Desc_FR": "Un seau de lave (nom anglais : lava bucket) est un seau rempli de lave.",
      "Desc_EN": "A lava bucket is a bucket filled with lava, which is the only way to carry it as an item. It can be used as fuel, smelting 100 items.",
      "Rarity": 1,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "https://raw.githubusercontent.com/MythMega/mythmega.github.io.assets/refs/heads/master/assets/category/minecraft/items/Lava_Bucket.png",
      "Layout": "classic",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ L005_classic.png"
    },
    {
      "Index": "SERIE-A2 / L006",
      "Name_FR": "Quartz du Nether",
      "Name_EN": "Nether Quartz",
      "Desc_FR": "Le quartz du Nether (nom anglais Nether quartz) est un objet obtenable en minant du minerai de quartz du Nether.",
      "Desc_EN": "Nether quartz is a mineral found in the Nether used mainly for crafting decorative blocks and redstone components. It can also be used as a smithing ingredient.",
      "Rarity": 1,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "https://raw.githubusercontent.com/MythMega/mythmega.github.io.assets/refs/heads/master/assets/category/minecraft/items/Nether_Quartz.png",
      "Layout": "classic",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ L006_classic.png"
    },
    {
      "Index": "SERIE-A2 / L007",
      "Name_FR": "Brique du Nether",
      "Name_EN": "Nether Brick",
      "Desc_FR": "La brique du Nether (nom anglais : Nether brick) est un objet fabriqué par la cuisson de la netherrack dans un fourneau.",
      "Desc_EN": "A Nether brick is an item created by smelting netherrack in a furnace, and is used to craft the Nether bricks block and its variants.",
      "Rarity": 1,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "https://raw.githubusercontent.com/MythMega/mythmega.github.io.assets/refs/heads/master/assets/category/minecraft/items/Nether_Brick.png",
      "Layout": "classic",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ L007_classic.png"
    },
    {
      "Index": "SERIE-A2 / L008",
      "Name_FR": "Verrues du Nether",
      "Name_EN": "Nether Wart",
      "Desc_FR": "Les verrues du Nether (nom anglais : nether wart) sont des champignons poussant naturellement dans le Nether, principalement utilisées en alchimie.",
      "Desc_EN": "Nether wart is a fungus harvested from Nether wart crops and is used to plant them. It is an essential ingredient in almost every potion. Unlike other crimson plants, Nether wart doesn't have a warped equivalent, although warped wart blocks exist.",
      "Rarity": 1,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "https://raw.githubusercontent.com/MythMega/mythmega.github.io.assets/refs/heads/master/assets/category/minecraft/items/Nether_Wart.png",
      "Layout": "classic",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ L008_classic.png"
    },
    {
      "Index": "SERIE-A2 / L009",
      "Name_FR": "Rose de Wither",
      "Name_EN": "Wither Rose",
      "Desc_FR": "Une rose de Wither (nom anglais : wither rose) est une fleur infligeant des dégâts au contact, qui est obtenue lorsqu'une créature est tuée par un Wither.",
      "Desc_EN": "A wither rose is a flower that inflicts the Wither effect on players and mobs that touch it. It drops when a mob or player is killed by a wither.",
      "Rarity": 2,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "https://raw.githubusercontent.com/MythMega/mythmega.github.io.assets/refs/heads/master/assets/category/minecraft/blocks/Wither_Rose.png",
      "Layout": "classic",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ L009_classic.png"
    },
    {
      "Index": "SERIE-A2 / X001",
      "Name_FR": "Disque Tears",
      "Name_EN": "Music Disc Tears",
      "Desc_FR": "",
      "Desc_EN": "\"Tears\" refers to both a song composed by Amos Roddy, and a music disc that plays the song when inserted in a jukebox. The music disc is dropped by ghasts when killed by a player-deflected ghast fireball.",
      "Rarity": 3,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "https://raw.githubusercontent.com/MythMega/mythmega.github.io.assets/refs/heads/master/assets/category/minecraft/items/Music_Disc_Tears.png",
      "Layout": "classic",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ X001_classic.png"
    },
    {
      "Index": "SERIE-A2 / X002",
      "Name_FR": "Disque Pigstep",
      "Name_EN": "Music Disc Pigstep",
      "Desc_FR": "",
      "Desc_EN": "\"Pigstep\" refers to both a song composed by Lena Raine, and a music disc that plays the song when inserted in a jukebox. The music disc is obtained from bastion remnants.",
      "Rarity": 3,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "https://raw.githubusercontent.com/MythMega/mythmega.github.io.assets/refs/heads/master/assets/category/minecraft/items/Music_Disc_Pigstep.png",
      "Layout": "classic",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ X002_classic.png"
    },
    {
      "Index": "SERIE-A2 / E001",
      "Name_FR": "Bottes en Netherite",
      "Name_EN": "Netherite Boots",
      "Desc_FR": "Les bottes (nom anglais : boots) sont une pièce d'armure qui couvre les pieds du joueur. Il existe six types de bottes : cuir, mailles, cuivre, fer, diamant, or et netherite.",
      "Desc_EN": "Netherite boots are a late-game variant of boots obtained by upgrading diamond boots using a netherite ingot and netherite upgrade at a smithing table. They are the highest tier of boots, having higher armor toughness, durability, and enchantability than diamond boots. Like all netherite armor, netherite boots provide 10% knockback resistance when worn, are immune to burning from fire and lava in item form, and take no durability damage from lava when worn.",
      "Rarity": 3,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "https://raw.githubusercontent.com/MythMega/mythmega.github.io.assets/refs/heads/master/assets/category/minecraft/items/Netherite_Boots.png",
      "Layout": "classic",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ E001_classic.png"
    },
    {
      "Index": "SERIE-A2 / E002",
      "Name_FR": "Jambières en Netherite",
      "Name_EN": "Netherite Leggings",
      "Desc_FR": "Des jambières (nom anglais : leggings) (la version en cuir étant nommée pantalon) sont une pièce d'armure qui couvre le bas du corps du joueur. Il existe sept types de jambières : cuir, mailles, cuivre, fer, diamant, or et netherite.",
      "Desc_EN": "Netherite leggings are a late-game variant of leggings obtained by upgrading diamond leggings using a netherite ingot and netherite upgrade at a smithing table. They are the highest tier of leggings, having higher armor toughness, durability, and enchantability than diamond leggings. Like all netherite armor, netherite leggings provide 10% knockback resistance when worn, are immune to burning from fire and lava in item form, and take no durability damage from lava when worn.",
      "Rarity": 3,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "https://raw.githubusercontent.com/MythMega/mythmega.github.io.assets/refs/heads/master/assets/category/minecraft/items/Netherite_Leggings.png",
      "Layout": "classic",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ E002_classic.png"
    },
    {
      "Index": "SERIE-A2 / E003",
      "Name_FR": "Plastron en Netherite",
      "Name_EN": "Netherite Chestplate",
      "Desc_FR": "Un plastron (nom anglais : chestplate) (la version en cuir étant nommée tunique) est une pièce d'armure qui couvre le haut du corps du joueur. Il existe six types de plastrons : cuir, mailles, cuivre, fer, diamant, or et netherite.",
      "Desc_EN": "A netherite chestplate is a late-game variant of chestplate obtained by upgrading a diamond chestplate using a netherite ingot and netherite upgrade at a smithing table. It is the highest tier of chestplate, having higher armor toughness, durability, and enchantability than a diamond chestplate. Like all netherite armor, a netherite chestplate provides 10% knockback resistance when worn, is immune to burning from fire and lava in item form, and takes no durability damage from lava when worn.",
      "Rarity": 3,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "https://raw.githubusercontent.com/MythMega/mythmega.github.io.assets/refs/heads/master/assets/category/minecraft/items/Netherite_Chestplate.png",
      "Layout": "classic",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ E003_classic.png"
    },
    {
      "Index": "SERIE-A2 / E004",
      "Name_FR": "Casque en Netherite",
      "Name_EN": "Netherite Helmet",
      "Desc_FR": "Un casque (nom anglais : helmet) (la version en cuir étant nommée chapeau) est une pièce d'armure qui couvre la tête du joueur. Il existe sept types principaux de casques qui font partie d'un ensemble d'armure complet : cuir, mailles, cuivre, fer, diamant, or et netherite.",
      "Desc_EN": "A netherite helmet is a late-game variant of helmet obtained by upgrading a diamond helmet using a netherite ingot and netherite upgrade at a smithing table. It is the highest tier of helmet, having higher armor toughness, durability, and enchantability than a diamond helmet. Like all netherite armor, a netherite helmet provides 10% knockback resistance when worn, is immune to burning from fire and lava in item form, and takes no durability damage from lava, fire, or magma damage when worn.",
      "Rarity": 3,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "https://raw.githubusercontent.com/MythMega/mythmega.github.io.assets/refs/heads/master/assets/category/minecraft/items/Netherite_Helmet.png",
      "Layout": "classic",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ E004_classic.png"
    },
    {
      "Index": "SERIE-A2 / E005",
      "Name_FR": "Épée en Netherite",
      "Name_EN": "Netherite Sword",
      "Desc_FR": "Les épées (nom anglais : swords) sont des armes qui servent à infliger des dégâts aux créatures et autres joueurs au corps-à-corps.",
      "Desc_EN": "A netherite sword is a late-game variant of sword obtained by upgrading a diamond sword using a netherite ingot and netherite upgrade at a smithing table. It is the highest tier of sword, dealing more damage than a diamond sword and having higher durability.",
      "Rarity": 4,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "https://raw.githubusercontent.com/MythMega/mythmega.github.io.assets/refs/heads/master/assets/category/minecraft/items/Netherite_Sword.png",
      "Layout": "classic",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ E005_classic.png"
    },
    {
      "Index": "SERIE-A2 / E006",
      "Name_FR": "Pioche en Netherite",
      "Name_EN": "Netherite Pickaxe",
      "Desc_FR": "Une pioche en netherite (nom anglais : netherite pickaxe) est une variante de pioche obtenue en améliorant une pioche en diamant avec un lingot de netherite et une amélioration en netherite dans une table de forge. Il s'agit de la pioche avec le tier le plus haut du jeu, avec une efficacité de minage, une durabilité, des dégâts et une enchantabilité supérieurs à une pioche en diamant. Son niveau de minage est de 4, qui est identique à un niveau de minage de 3, ce qui lui permet de miner l'obsidienne et les débris antiques.",
      "Desc_EN": "A netherite pickaxe is a late-game variant of pickaxe obtained by upgrading a diamond pickaxe using a netherite ingot and netherite upgrade at a smithing table. It is the highest tier of pickaxe, having higher mining efficiency, durability, attack damage, and enchantability than a diamond pickaxe. It has a mining level of 4, which is functionally identical to a mining level of 3, allowing it to mine obsidian and ancient debris.",
      "Rarity": 4,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "https://raw.githubusercontent.com/MythMega/mythmega.github.io.assets/refs/heads/master/assets/category/minecraft/items/Netherite_Pickaxe.png",
      "Layout": "classic",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ E006_classic.png"
    },
    {
      "Index": "SERIE-A2 / E007",
      "Name_FR": "Hache en Netherite",
      "Name_EN": "Netherite Axe",
      "Desc_FR": "Les haches (nom anglais : axes) sont des outils auxiliaires utilisés pour faciliter la collecte du bois et autres objets en bois (planches, coffres, bibliothèques, etc...), mais ne sont cependant pas indispensables pour collecter ces objets. Elles peuvent également être utilisées en tant qu’armes.",
      "Desc_EN": "A netherite axe is a late-game variant of axe obtained by upgrading a diamond axe using a netherite ingot and netherite upgrade at a smithing table. It can be used to cut down trees faster, to strip logs and scrape copper-based blocks, and as a melee weapon that disables shields. It is the highest tier of axe, having higher mining efficiency, attack damage, durability, and enchantability than a diamond axe.",
      "Rarity": 4,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "https://raw.githubusercontent.com/MythMega/mythmega.github.io.assets/refs/heads/master/assets/category/minecraft/items/Netherite_Axe.png",
      "Layout": "classic",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ E007_classic.png"
    },
    {
      "Index": "SERIE-A2 / E008",
      "Name_FR": "Pelle en Netherite",
      "Name_EN": "Netherite Shovel",
      "Desc_FR": "Les pelles (nom anglais : shovels) sont des outils auxiliaires utilisés pour faciliter la collecte de terre, de sable, de gravier, d'argile et de neige.",
      "Desc_EN": "A netherite shovel is a late-game variant of shovel obtained by upgrading a diamond shovel using a netherite ingot and netherite upgrade at a smithing table. It is used to break dirt, sand, gravel and other related blocks faster, to create dirt paths from dirt-related blocks, and to extinguish campfires. It is the highest tier of shovel, having higher mining efficiency, attack damage, durability, and enchantability than a diamond shovel.",
      "Rarity": 4,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "https://raw.githubusercontent.com/MythMega/mythmega.github.io.assets/refs/heads/master/assets/category/minecraft/items/Netherite_Shovel.png",
      "Layout": "classic",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ E008_classic.png"
    },
    {
      "Index": "SERIE-A2 / E009",
      "Name_FR": "Houe en Netherite",
      "Name_EN": "Netherite Hoe",
      "Desc_FR": "La houe (nom anglais : hoe) est un outil servant à labourer la terre et les blocs d'herbe pour les changer en terre labourée, ainsi qu'à récolter plus rapidement certains blocs.",
      "Desc_EN": "A netherite hoe is a late-game variant of hoe obtained by upgrading a diamond hoe using a netherite ingot and netherite upgrade at a smithing table. It is used to till dirt-related blocks into farmland, and to break leaves, haybales, and sculk-related blocks faster. It is the highest tier of hoe, having higher mining efficiency, durability, damage,‌[BE only] and enchantability than a diamond hoe.",
      "Rarity": 4,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "https://raw.githubusercontent.com/MythMega/mythmega.github.io.assets/refs/heads/master/assets/category/minecraft/items/Netherite_Hoe.png",
      "Layout": "classic",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ E009_classic.png"
    },
    {
      "Index": "SERIE-A2 / E010",
      "Name_FR": "Armure en Netherite pour cheval",
      "Name_EN": "Netherite Horse Armor",
      "Desc_FR": "L'armure pour cheval (nom anglais : horse armor) est un type d'armure spécifique aux chevaux. Elle existe en plusieurs variantes : cuir, cuivre, fer, or, diamant et netherite.",
      "Desc_EN": "Netherite horse armor is the strongest tier of horse armor.",
      "Rarity": 3,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "https://raw.githubusercontent.com/MythMega/mythmega.github.io.assets/refs/heads/master/assets/category/minecraft/items/Netherite_Horse_Armor.png",
      "Layout": "classic",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ E010_classic.png"
    },
    {
      "Index": "SERIE-A2 / E011",
      "Name_FR": "Étoile du Nether",
      "Name_EN": "Nether Star",
      "Desc_FR": "L'étoile du Nether (nom anglais : nether star) est un objet obtenu à la mort du Wither nécessaire à la fabrication de la balise.",
      "Desc_EN": "A Nether star is an item that is dropped by the wither upon death. It is used to craft a beacon, and cannot be destroyed by explosions.",
      "Rarity": 5,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "https://raw.githubusercontent.com/MythMega/mythmega.github.io.assets/refs/heads/master/assets/category/minecraft/items/Nether_Star.png",
      "Layout": "fullart",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ E011_fullart.png"
    },
    {
      "Index": "SERIE-A2 / C001",
      "Name_FR": "Piglin",
      "Name_EN": "Piglin",
      "Desc_FR": "Un Piglin est une créature neutre qui apparaît dans le Nether. Il est possible de troquer avec eux en utilisant des lingots d'or pour recevoir de nombreux objets.",
      "Desc_EN": "A piglin is a neutral mob found in the Nether. It is hostile to players unless they wear at least one piece of golden armor. It can be given gold ingots to barter for various items. It wields either a golden sword, a golden spear, or a crossbow and uses either melee, spear charge, or ranged attacks, respectively.",
      "Rarity": 5,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "",
      "Layout": "fullart",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ C001_fullart.png"
    },
    {
      "Index": "SERIE-A2 / C002",
      "Name_FR": "Piglin zombifié",
      "Name_EN": "Zombified Piglin",
      "Desc_FR": "Un Piglin zombifié (nom anglais : zombified piglin), anciennement cochon-zombie (nom anglais : zombie pigman), est une variante morte-vivante neutre du Piglin vivant dans le Nether.",
      "Desc_EN": "Zombified piglins are neutral and undead variants of piglins that spawn in the Nether. Zombified piglins normally ignore players, but if one gets attacked and survives, it and all other zombified piglins in the vicinity become hostile and attack the aggressor.",
      "Rarity": 5,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "",
      "Layout": "fullart",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ C002_fullart.png"
    },
    {
      "Index": "SERIE-A2 / C003",
      "Name_FR": "Piglin barbare",
      "Name_EN": "Piglin Brute",
      "Desc_FR": "Les piglins barbares (nom anglais : Piglin brutes) sont des créatures hostiles trouvées dans les vestiges de bastion.",
      "Desc_EN": "A piglin brute is a hostile and stronger variant of the piglin. It wields a golden axe and appears in all types of bastion remnants. Unlike piglins, piglin brutes do not barter, retreat, or get distracted by gold.",
      "Rarity": 5,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "",
      "Layout": "fullart",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ C003_fullart.png"
    },
    {
      "Index": "SERIE-A2 / C004",
      "Name_FR": "Cube de magma",
      "Name_EN": "Magma Cube",
      "Desc_FR": "Les cubes de magma (nom anglais : magma cubes) sont des créatures hostiles qui se trouvent uniquement dans le Nether. Ils sont considérés comme l'équivalent du Slime dans le Nether, possédant un comportement similaire.",
      "Desc_EN": "A magma cube is a hostile mob found in the Nether. A magma cube behaves similarly to a slime in that it splits into smaller magma cubes on death, all the way down to tiny size, but is fireproof, jumps higher and less often, and deals more damage. Magma cubes are a source of magma cream and the only source of froglights if eaten by a frog while small.",
      "Rarity": 5,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "",
      "Layout": "fullart",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ C004_fullart.png"
    },
    {
      "Index": "SERIE-A2 / C005",
      "Name_FR": "Blaze",
      "Name_EN": "Blaze",
      "Desc_FR": "Un Blaze est une créature hostile flottante qui apparaît dans les forteresses du Nether.",
      "Desc_EN": "A blaze is a fiery hostile mob found in Nether fortresses and is the only source of blaze rods. It attacks by shooting volleys of three small fireballs or by performing melee attacks at close range, and it often floats upward while targeting a player.",
      "Rarity": 5,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "",
      "Layout": "fullart",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ C005_fullart.png"
    },
    {
      "Index": "SERIE-A2 / C006",
      "Name_FR": "Hoglin",
      "Name_EN": "Hoglin",
      "Desc_FR": "Les Hoglins sont des créatures hostiles élevables ressemblant aux sangliers qui constituent la principale source de nourriture dans le Nether.",
      "Desc_EN": "Hoglins are breedable hostile mobs found in the Nether, and a source of porkchops and leather. Hoglins are repelled by warped fungi that is placed in the world as well as active Nether portals and respawn anchors. They attack by thrusting their tusks upward, which can also launch their target a short distance into the air.",
      "Rarity": 5,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "",
      "Layout": "fullart",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ C006_fullart.png"
    },
    {
      "Index": "SERIE-A2 / C007",
      "Name_FR": "Arpenteur",
      "Name_EN": "Strider",
      "Desc_FR": "Un arpenteur (nom anglais : strider) est une créature passive qui apparaît dans le Nether. Elle peut être utilisée pour se déplacer au-dessus de la lave.",
      "Desc_EN": "A strider is a passive mob found in the Nether. It can walk on lava and be saddled by the player, being directed via a warped fungus on a stick. They can be fed warped fungus to breed, and are a source of string.",
      "Rarity": 5,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "",
      "Layout": "fullart",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ C007_fullart.png"
    },
    {
      "Index": "SERIE-A2 / C008",
      "Name_FR": "Wither squelette",
      "Name_EN": "Wither Skeleton",
      "Desc_FR": "Le Wither squelette (nom anglais : Wither skeleton) est une créature hostile qui apparaît dans les forteresses du Nether. Le Wither squelette est l'équivalent corrompu du squelette dans le Nether.",
      "Desc_EN": "A wither skeleton is a tall, black variant of a skeleton equipped with a stone sword. They inflict the Wither effect when attacking the player. They are found exclusively in Nether fortresses and are the only source of wither skeleton skulls, as well as the only renewable source of coal.",
      "Rarity": 5,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "",
      "Layout": "fullart",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ C008_fullart.png"
    },
    {
      "Index": "SERIE-A2 / C009",
      "Name_FR": "Wither",
      "Name_EN": "Wither",
      "Desc_FR": "Le Wither est une créature flottante à l'apparence squelettique qui tire des crânes explosifs sur ses ennemis.",
      "Desc_EN": "The wither is an undead boss mob spawned by building a specific structure using soul sand or soul soil and three wither skeleton skulls. It is able to fly, fires explosive blue and black skulls at players and most non-undead mobs, and becomes immune to some types of projectiles when it is below half health. It is the only source of Nether stars, which are needed to craft beacons.",
      "Rarity": 5,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "",
      "Layout": "fullart",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ C009_fullart.png"
    },
    {
      "Index": "SERIE-A2 / C010",
      "Name_FR": "Wither rose",
      "Name_EN": "Pink Wither",
      "Desc_FR": "Le Wither rose (nom anglais et officiel : pink wither) est un monstre présent uniquement dans l'Édition Java 2.0, publiée le 1er avril 2013 et la snapshot 15w14a, publiée le 1er avril 2015. Ce monstre fait partie de la traditionnelle blague du 1er avril faite par Mojang. Le Wither rose est une version gentille du Wither classique.",
      "Desc_EN": "The pink wither or friendly wither was a recurring April Fools' mob present in both Java Edition 2.0 and 15w14a.",
      "Rarity": 5,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "",
      "Layout": "fullart",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ C010_fullart.png"
    },
    {
      "Index": "SERIE-A2 / S001",
      "Name_FR": "Fossile du Nether",
      "Name_EN": "Nether Fossil",
      "Desc_FR": "",
      "Desc_EN": "Nether fossils are fossils that generate in soul sand valleys that can sometimes contain dried ghasts.",
      "Rarity": 4,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "",
      "Layout": "fullart",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ S001_fullart.png"
    },
    {
      "Index": "SERIE-A2 / S002",
      "Name_FR": "Portail en ruine",
      "Name_EN": "Ruined Portal",
      "Desc_FR": "",
      "Desc_EN": "A ruined portal is a structure resembling a damaged Nether portal, which generates commonly in both the Nether and the Overworld. It contains some decoration and a loot chest around it.",
      "Rarity": 4,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "",
      "Layout": "fullart",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ S002_fullart.png"
    },
    {
      "Index": "SERIE-A2 / S003",
      "Name_FR": "Vestiges de bastion",
      "Name_EN": "Bastion Remnant",
      "Desc_FR": "Les vestiges de bastion (nom anglais : bastion remnants) sont de grandes structures générées dans le Nether, dans tous les biomes sauf les deltas de basalte. Les piglins et les hoglins y apparaissent communément. Les vestiges de bastion sont le seul endroit où le disque de musique Pigstep, le motif de bannière « Groin de Piglin » et des fragments de netherite peuvent être trouvés naturellement.",
      "Desc_EN": "Bastion remnants, also simply referred to as bastions, are large, castle-like generated structures found in the Nether in all of the biomes except basalt deltas. They generate in four distinct variants, each with a unique structure and set of loot. Piglins and piglin brutes spawn in these structures on generation, and hoglins may also spawn on generation in the bridge and hoglin stables variants. Bastion remnants are the only place to find gilded blackstone, the Pigstep music disc, the snout banner pattern and armor trim, monster spawners which spawn magma cubes, and the netherite upgrade smithing template.",
      "Rarity": 4,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "",
      "Layout": "fullart",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ S003_fullart.png"
    },
    {
      "Index": "SERIE-A2 / S004",
      "Name_FR": "Forteresse du Nether",
      "Name_EN": "Nether Fortress",
      "Desc_FR": "Une forteresse du Nether (nom anglais : Nether fortress) est une structure générée naturellement dans le Nether. Elles contiennent souvent des générateurs de Blazes et sont le seul endroit où l'on peut trouver des verrues du Nether avec les vestiges de bastion.",
      "Desc_EN": "A Nether fortress is an uncommon large structure made of Nether bricks found in the Nether, consisting of bridges, corridors, and towers. Nether fortresses are the only place where wither skeletons and blazes spawn. They also contain Nether wart.",
      "Rarity": 4,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "",
      "Layout": "fullart",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ S004_fullart.png"
    },
    {
      "Index": "SERIE-A2 / Z001",
      "Name_FR": "Terres désolées du Nether",
      "Name_EN": "Nether Wastes",
      "Desc_FR": "Les Terres désolées du Nether (nom anglais : Nether Wastes) sont le biome le plus courant dans le Nether.",
      "Desc_EN": "The Nether wastes or hell‌[Bedrock Edition only] is the most common biome found in the Nether.",
      "Rarity": 4,
      "Style": "Press Start 2P (Pixel)",
      "Background": "https://minecraft.wiki/images/thumb/Nether_Wastes_Vibrant_Visuals.png/1000px-Nether_Wastes_Vibrant_Visuals.png?ccb7f",
      "Underlay": "",
      "Layout": "fullart",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ Z001_fullart.png"
    },
    {
      "Index": "SERIE-A2 / Z002",
      "Name_FR": "Vallée des âmes",
      "Name_EN": "Soul Sand Valley",
      "Desc_FR": "La vallée des âmes (nom anglais : soul sand valley) est un biome sec situé dans le Nether. Il est formé de grandes cavernes contenant des fossiles du Nether et différents blocs, dont principalement du sable des âmes et de la terre des âmes.",
      "Desc_EN": "A soul sand valley is a dry biome located in the Nether. It is formed of large caverns with Nether fossils and different blocks, mainly including soul sand and soul soil.",
      "Rarity": 4,
      "Style": "Press Start 2P (Pixel)",
      "Background": "https://minecraft.wiki/images/thumb/Soul_Sand_Valley_Vibrant_Visuals.png/1000px-Soul_Sand_Valley_Vibrant_Visuals.png?105c4",
      "Underlay": "",
      "Layout": "fullart",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ Z002_fullart.png"
    },
    {
      "Index": "SERIE-A2 / Z003",
      "Name_FR": "Forêt carmin",
      "Name_EN": "Crimson Forest",
      "Desc_FR": "La forêt carmin (nom anglais : crimson forest) est un biome forestier du Nether.",
      "Desc_EN": "The crimson forest is a forested biome in the Nether. It is one of two Nether biomes where players are able to acquire wood without returning to the Overworld. This forest is the only place where huge crimson fungus trees grow naturally.",
      "Rarity": 4,
      "Style": "Press Start 2P (Pixel)",
      "Background": "https://minecraft.wiki/images/thumb/Crimson_Forest_Vibrant_Visuals.png/1000px-Crimson_Forest_Vibrant_Visuals.png?742e0",
      "Underlay": "",
      "Layout": "fullart",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ Z003_fullart.png"
    },
    {
      "Index": "SERIE-A2 / Z004",
      "Name_FR": "Forêt biscornue",
      "Name_EN": "Warped Forest",
      "Desc_FR": "La forêt biscornue (nom anglais : warped forest) est un biome du Nether. il s'agit d'un biome relativement sûr car aucune créature hostile n'y apparaît naturellement.",
      "Desc_EN": "The warped forest is an uncommon forested biome found in the Nether. Endermen are common in this biome, and hostile mobs do not spawn naturally. It is one of two Nether biomes where players are able to acquire wood without returning to the Overworld. The warped forest is the only place where huge warped fungi grow naturally.",
      "Rarity": 4,
      "Style": "Press Start 2P (Pixel)",
      "Background": "https://minecraft.wiki/images/thumb/Warped_Forest_Vibrant_Visuals.png/1000px-Warped_Forest_Vibrant_Visuals.png?f9da7",
      "Underlay": "",
      "Layout": "fullart",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ Z004_fullart.png"
    },
    {
      "Index": "SERIE-A2 / Z005",
      "Name_FR": "Deltas de basalte",
      "Name_EN": "Basalt Deltas",
      "Desc_FR": "Les deltas de basalte (nom anglais : basalt deltas) sont un biome volcanique situé dans le Nether.",
      "Desc_EN": "The basalt deltas are a volcanic biome found in the Nether.",
      "Rarity": 4,
      "Style": "Press Start 2P (Pixel)",
      "Background": "https://minecraft.wiki/images/thumb/Basalt_Deltas_Vibrant_Visuals.png/1000px-Basalt_Deltas_Vibrant_Visuals.png?1862c",
      "Underlay": "",
      "Layout": "fullart",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ Z005_fullart.png"
    }
  ]
}