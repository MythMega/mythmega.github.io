{
  "id": "./",
  "name": "Pokefeet",
  "short_name": "Pokefeet",
  "description": "Jeu de devinettes Pokémon : devinez le Pokémon en ne voyant que son pied ou ses pieds. Daily challenge, weekly challenge, marathon et défis custom.",
  "lang": "fr",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#060c18",
  "theme_color": "#060c18",
  "categories": ["games", "entertainment", "education"],
