<?xml version="1.0" encoding="UTF-8"?>
<!--
  MineCards — sitemap.

  The game is a single-page application: one URL serves every screen (onboarding,
  opening, collection, statistics, information, settings). Only the two declared
  language versions are listed, because they are the only variants that produce a
  different document: `/` is French (`?lang=fr` is equivalent) and `/?lang=en` is
  English.

  Every <loc> is absolute and matches the canonical URL declared in index.html.
  Update both together if the site moves.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">

  <!-- French (default) — the URL the site is also reachable at with ?lang=fr -->
  <url>
    <loc>https://web.jmdev.fr/projets/minecards/</loc>
    <xhtml:link rel="alternate" hreflang="fr" href="https://web.jmdev.fr/projets/minecards/"/>
    <xhtml:link rel="alternate" hreflang="en" href="https://web.jmdev.fr/projets/minecards/?lang=en"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="https://web.jmdev.fr/projets/minecards/"/>
    <lastmod>2026-10-10</lastmod>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>

  <!-- English -->
  <url>
    <loc>https://web.jmdev.fr/projets/minecards/?lang=en</loc>
    <xhtml:link rel="alternate" hreflang="fr" href="https://web.jmdev.fr/projets/minecards/"/>
    <xhtml:link rel="alternate" hreflang="en" href="https://web.jmdev.fr/projets/minecards/?lang=en"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="https://web.jmdev.fr/projets/minecards/"/>
    <lastmod>2026-10-10</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.9</priority>
  </url>

</urlset>
