<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>
    <Color x:Key="Navy">#0B1C46</Color>
    <Color x:Key="NavySoft">#1B356E</Color>
    <Color x:Key="Blue">#2E5BFF</Color>
    <Color x:Key="Sky">#7BA4FF</Color>
    <Color x:Key="Muted">#5B6B92</Color>
    <Color x:Key="Line">#C7D7F0</Color>
    <Color x:Key="Danger">#B3261E</Color>
    <SolidColorBrush x:Key="NavyBrush" Color="{StaticResource Navy}" />
    <SolidColorBrush x:Key="NavySoftBrush" Color="{StaticResource NavySoft}" />
    <SolidColorBrush x:Key="BlueBrush" Color="{StaticResource Blue}" />
    <SolidColorBrush x:Key="SkyBrush" Color="{StaticResource Sky}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource Muted}" />
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource Line}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}" />
    <SolidColorBrush x:Key="CardBrush" Color="#F2FFFFFF" />
    <SolidColorBrush x:Key="FieldBrush" Color="#F7FAFF" />
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="FontFamily" Value="Inter, Segoe UI, Helvetica Neue, sans-serif" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Background" Value="#F3F7FF" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource NavyBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="-0.4" />
  </Style>

  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <Style Selector="TextBlock.h3">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.muted">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    <Setter Property="LineHeight" Value="18" />
  </Style>

  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource NavySoftBrush}" />
  </Style>

  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="Cascadia Mono, SF Mono, Consolas, monospace" />
  </Style>

  <Style Selector="TextBlock.danger">
    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
  </Style>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{StaticResource CardBrush}" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="BorderBrush" Value="#B9CCE9" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="20" />
    <Setter Property="BoxShadow" Value="0 18 42 0 #100B1C46" />
  </Style>

  <Style Selector="Border.glass">
    <Setter Property="Background" Value="#D9FFFFFF" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="BorderBrush" Value="#A8C0E4" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BoxShadow" Value="0 10 28 0 #0E0B1C46" />
  </Style>

  <Style Selector="Border.pill">
    <Setter Property="Background" Value="#EAF1FF" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Padding" Value="9,4" />
  </Style>

  <Style Selector="Border.dropzone">
    <Setter Property="Background" Value="#F4F8FF" />
    <Setter Property="BorderBrush" Value="#9DB9E4" />
    <Setter Property="BorderThickness" Value="1.4" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="18" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Border.dropzone:pointerover">
    <Setter Property="Background" Value="#EAF2FF" />
    <Setter Property="BorderBrush" Value="{StaticResource SkyBrush}" />
  </Style>

  <Style Selector="Border.inset">
    <Setter Property="Background" Value="#F7FAFF" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="BorderBrush" Value="#D7E3F6" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12" />
  </Style>

  <Style Selector="Button">
    <Setter Property="Background" Value="#EAF1FF" />
    <Setter Property="Foreground" Value="{StaticResource NavyBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button:pointerover">
    <Setter Property="Opacity" Value="0.88" />
  </Style>

  <Style Selector="Button:pressed">
    <Setter Property="Opacity" Value="0.76" />
  </Style>

  <Style Selector="Button:disabled">
    <Setter Property="Opacity" Value="0.42" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{StaticResource NavyBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="MinHeight" Value="42" />
    <Setter Property="Padding" Value="16,10" />
  </Style>

  <Style Selector="Button.primary:pointerover">
    <Setter Property="Background" Value="{StaticResource NavySoftBrush}" />
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- The global TextBlock style sets a navy foreground, which would otherwise
       paint navy text on the navy primary button. -->
  <Style Selector="Button.primary TextBlock">
    <Setter Property="Foreground" Value="White" />
  </Style>

  <Style Selector="Button.compact">
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="MinHeight" Value="29" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
  </Style>

  <Style Selector="Button.danger">
    <Setter Property="Background" Value="#FCE9E8" />
    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
  </Style>

  <Style Selector="Button.icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="31" />
    <Setter Property="Height" Value="31" />
    <Setter Property="MinHeight" Value="31" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Foreground" Value="{StaticResource NavySoftBrush}" />
  </Style>

  <Style Selector="Button.icon:pointerover">
    <Setter Property="Background" Value="#E4EDFF" />
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="Button.icon.danger">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
  </Style>

  <Style Selector="Button.tab">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource NavySoftBrush}" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="CornerRadius" Value="11" />
  </Style>

  <Style Selector="Button.tab:pointerover">
    <Setter Property="Background" Value="#E7EFFF" />
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="Button.tab.active">
    <Setter Property="Background" Value="{StaticResource NavyBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <Style Selector="Button.tab.active:pointerover">
    <Setter Property="Background" Value="{StaticResource NavySoftBrush}" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="Background" Value="White" />
    <Setter Property="Foreground" Value="{StaticResource NavyBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="9,7" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="SelectionBrush" Value="{StaticResource SkyBrush}" />
  </Style>

  <Style Selector="TextBox:focus">
    <Setter Property="BorderBrush" Value="{StaticResource SkyBrush}" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="Background" Value="White" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="9,4" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="Slider">
    <Setter Property="Foreground" Value="{StaticResource NavyBrush}" />
    <Setter Property="MinHeight" Value="28" />
  </Style>

  <Style Selector="ProgressBar">
    <Setter Property="Height" Value="6" />
    <Setter Property="Foreground" Value="{StaticResource NavyBrush}" />
    <Setter Property="Background" Value="#E2EAF9" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="MinHeight" Value="6" />
  </Style>

  <Style Selector="ScrollViewer">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{StaticResource NavyBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="8,5" />
  </Style>

  <!-- Tooltip text is generated by the content presenter, so the global
       TextBlock foreground would make it unreadable on the navy tooltip. -->
  <Style Selector="ToolTip TextBlock">
    <Setter Property="Foreground" Value="White" />
  </Style>

</Styles>
