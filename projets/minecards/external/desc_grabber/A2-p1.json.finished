    {
      "Index": "SERIE-A2 / N007",
      "Name_FR": "Champignon carmin",
      "Name_EN": "Crimson Fungus",
      "Desc_FR": "Un champignon carmin (nom anglais : crimson fungus) est un fungi qui apparaît dans le Nether.",
      "Desc_EN": "A crimson fungus is a fungus found in crimson and warped forests or by using bone meal on nylium. It can grow into a huge crimson fungus if bone mealed, but only if planted on crimson nylium. It can also be fed to hoglins.",
      "Rarity": 1,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "https://raw.githubusercontent.com/MythMega/mythmega.github.io.assets/refs/heads/master/assets/category/minecraft/blocks/Crimson_Fungus.png",
      "Layout": "classic",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ N007_classic.png"
    },
    {
      "Index": "SERIE-A2 / N008",
      "Name_FR": "Nylium biscornu",
      "Name_EN": "Warped Nylium",
      "Desc_FR": "Le nylium est un bloc qui se génère dans le Nether. Il possède deux variantes : le nylium biscornu (nom anglais : warped nylium) et le nylium carmin (nom anglais : crimson nylium).",
      "Desc_EN": "Warped nylium is a variant of netherrack that generates in the Nether.",
      "Rarity": 1,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "https://raw.githubusercontent.com/MythMega/mythmega.github.io.assets/refs/heads/master/assets/category/minecraft/blocks/Warped_Nylium.png",
      "Layout": "classic",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ N008_classic.png"
    },
    {
      "Index": "SERIE-A2 / N009",
      "Name_FR": "Tige biscornue",
      "Name_EN": "Warped Hyphae",
      "Desc_FR": "Le bois (nom anglais : wood) et les hyphes (nom anglais : hyphae) sont des blocs possédant la texture des bûches ou des tiges sur leurs 6 faces. Ils se déclinent en autant d'essences que leur homologue.",
      "Desc_EN": "Wood or hyphae is a block that has the log's \"bark\" texture on all six sides. It comes in 12 types: oak, spruce, birch, jungle, acacia, dark oak, mangrove, cherry, crimson, warped, pale oak, and poplar.",
      "Rarity": 1,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "https://raw.githubusercontent.com/MythMega/mythmega.github.io.assets/refs/heads/master/assets/category/minecraft/blocks/Warped_Hyphae.png",
      "Layout": "classic",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ N009_classic.png"
    },
    {
      "Index": "SERIE-A2 / N010",
      "Name_FR": "Planches biscornues",
      "Name_EN": "Warped Planks",
      "Desc_FR": "Les planches (nom anglais : planks) sont des blocs fabriqués à partir de bûches. Elles ont l'apparence de séries de planches jointes entre elles.",
      "Desc_EN": "Planks are common blocks used as building blocks and in crafting recipes. They are usually one of the first things that a player crafts in Survival mode. There are currently 13 variants of planks, which can be differentiated into three categories: Overworld planks made from tree logs, bamboo planks made from blocks of bamboo, and nonflammable Nether planks made from huge fungus stems.",
      "Rarity": 1,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "https://raw.githubusercontent.com/MythMega/mythmega.github.io.assets/refs/heads/master/assets/category/minecraft/blocks/Warped_Planks.png",
      "Layout": "classic",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ N010_classic.png"
    },
    {
      "Index": "SERIE-A2 / N011",
      "Name_FR": "Barrière biscornue",
      "Name_EN": "Warped Fence",
      "Desc_FR": "Une barrière en bois (nom anglais : wooden fence) est une variante de barrière fabriquée à partir de planches et de bâtons.",
      "Desc_EN": "A wooden fence is the wooden variant of fences, crafted using planks and sticks.",
      "Rarity": 1,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "https://raw.githubusercontent.com/MythMega/mythmega.github.io.assets/refs/heads/master/assets/category/minecraft/blocks/Warped_Fence.png",
      "Layout": "classic",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ N011_classic.png"
    },
    {
      "Index": "SERIE-A2 / N012",
      "Name_FR": "Escalier biscornu",
      "Name_EN": "Warped Stairs",
      "Desc_FR": "Un escalier en bois (nom anglais : wooden stairs) est une variante en bois d'un escalier, fabriquée à partir des planches correspondantes.",
      "Desc_EN": "Wooden stairs are a wooden variant of stairs, crafted from their respective planks.",
      "Rarity": 1,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "https://raw.githubusercontent.com/MythMega/mythmega.github.io.assets/refs/heads/master/assets/category/minecraft/blocks/Warped_Stairs.png",
      "Layout": "classic",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ N012_classic.png"
    },
    {
      "Index": "SERIE-A2 / N013",
      "Name_FR": "Dalle biscornue",
      "Name_EN": "Warped Slab",
      "Desc_FR": "Une dalle en bois (nom anglais : wooden slab) est une variante en bois d'une dalle, fabriquée à partir des planches correspondantes.",
      "Desc_EN": "A wooden slab is a wooden variant of a slab crafted from its respective planks.",
      "Rarity": 1,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "https://raw.githubusercontent.com/MythMega/mythmega.github.io.assets/refs/heads/master/assets/category/minecraft/blocks/Warped_Slab.png",
      "Layout": "classic",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ N013_classic.png"
    },
    {
      "Index": "SERIE-A2 / N014",
      "Name_FR": "Pancarte biscornue",
      "Name_EN": "Warped Sign",
      "Desc_FR": "Une pancarte, ou panneau, (nom anglais : sign) est un bloc non-solide qui affiche un texte, et qui peut être placée sur le dessus ou le côté des blocs. Il est possible de personnaliser le texte en utilisant des teintures ou des poches d'encres luisantes. Utiliser un rayon de miel sur une pancarte permet d'empêcher toute modification du texte.",
      "Desc_EN": "A sign is a non-solid block that can display text, and can be placed on the top or side of other blocks. The text of signs can be customized with dyes and glow ink sacs, and they can be waxed to prevent its text from being edited by any player.",
      "Rarity": 1,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "https://raw.githubusercontent.com/MythMega/mythmega.github.io.assets/refs/heads/master/assets/category/minecraft/blocks/Warped_Sign.png",
      "Layout": "classic",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ N014_classic.png"
    },
    {
      "Index": "SERIE-A2 / N015",
      "Name_FR": "Trappe biscornue",
      "Name_EN": "Warped Trapdoor",
      "Desc_FR": "Une trappe en bois (nom anglais : wooden trapdoor) est un bloc solide, transparent, qui peut être utilisé comme une barrière ouvrante.",
      "Desc_EN": "A wooden trapdoor is a variant of the trapdoor that can be opened and closed by the player without redstone.",
      "Rarity": 1,
      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "https://raw.githubusercontent.com/MythMega/mythmega.github.io.assets/refs/heads/master/assets/category/minecraft/blocks/Warped_Trapdoor.png",
      "Layout": "classic",
      "Path": "./cards/A2/<lang>/SERIE-A2 _ N015_classic.png"
    },
    {
      "Index": "SERIE-A2 / N016",
      "Name_FR": "Bloc de verrues biscornues",
      "Name_EN": "Warped Wart Block",
      "Desc_FR": "Le bloc de verrues biscornues (nom anglais : warped wart block) est un bloc décoratif qui apparaît dans les forêts biscornues, et qui sont générés à partir des champignons géants biscornus.",
      "Desc_EN": "Warped wart blocks are a decorative block found in warped forests, generating as part of huge warped fungus.",
