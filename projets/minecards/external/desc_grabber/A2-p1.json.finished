      "Style": "Press Start 2P (Pixel)",
      "Background": "",
      "Underlay": "https://raw.githubusercontent.com/MythMega/mythmega.github.io.assets/refs/heads/master/assets/category/minecraft/blocks/Warped_Wart_Block.png",
