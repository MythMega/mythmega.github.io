<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Avalonia interface, shared by every head: the desktop executable and the
    Android app. Namespaces stay rooted at "Bulkut" so the UI code did not have
    to be rewritten when it was extracted from the desktop project.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Bulkut</RootNamespace>
    <AssemblyName>Bulkut.Shared</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bulkut.Core\Bulkut.Core.csproj" />
  </ItemGroup>

</Project>
