{
  "name": "MineCards — TCG Minecraft",
  "short_name": "MineCards",
  "description": "Ouvrez des boosters gratuits et collectionnez les cartes de l'univers Minecraft : 222 cartes dans l'extension Genèse, 5 raretés, impressions classiques et Full Art.",
  "lang": "fr",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "id": "/projets/minecards/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "portrait",
  "background_color": "#0b0e14",
  "theme_color": "#0b0e14",
  "categories": ["games", "entertainment"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "assets/icons/favicon-32.png", "sizes": "32x32", "type": "image/png" },
    { "src": "assets/icons/favicon-48.png", "sizes": "48x48", "type": "image/png" },
    { "src": "assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "assets/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "assets/icons/apple-touch-icon.png", "sizes": "180x180", "type": "image/png" }
  ]
}
